{
  "kind": "collectionType",
  "collectionName": "staff_members",
  "info": {
    "singularName": "staff",
    "pluralName": "staffs",
    "displayName": "Staff",
    "description": "Coaching and club staff."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "role": {
      "type": "string",
      "required": true
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "bio": {
      "type": "richtext"
    },
    "socials": {
      "type": "component",
      "component": "shared.social-links",
      "repeatable": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  }
}
